#!/bin/sh
# Rejects commit messages that are not Conventional Commits.
# Enabled once per clone with: git config core.hooksPath .githooks
subject=$(grep -v '^#' "$1" | head -n 1)

case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*"; then
	exit 0
fi

cat >&2 <<MSG
Commit message is not a Conventional Commit:
  $subject

Use: <type>[(scope)][!]: <description>
Types: feat fix docs style refactor perf test build ci chore revert
Example: feat(webhook): send payload with timeout
See CONTRIBUTING.md.
MSG
exit 1
