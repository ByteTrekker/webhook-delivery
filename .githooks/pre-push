#!/bin/sh
# Blocks pushes to main and branches whose diff against main is too big.
# Enabled once per clone with: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "Do not push to main. Push a branch and open a pull request." >&2
		exit 1
	fi
	case "$local_sha" in
	*[!0]*) "$root/scripts/check-pr-size.sh" "$local_sha" || exit 1 ;;
	esac
done
exit 0
